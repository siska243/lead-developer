# Names only – real values come from the environment / secret manager, never from git.

# --- HTTP transport (remote clients) ---
MCP_HOST=127.0.0.1
MCP_PORT=3001
# Public URL of the MCP endpoint, used as OAuth resource identifier (RFC 8707).
MCP_PUBLIC_URL=https://api.example.test/mcp
# Comma-separated Host header allow-list (DNS rebinding protection) when not bound to localhost.
MCP_ALLOWED_HOSTS=
# Authorization server (see ../oauth/README.md). One set per environment.
OAUTH_ISSUER=
OAUTH_AUDIENCE=
OAUTH_JWKS_URL=
# RFC 8414 metadata URL of the authorization server.
OAUTH_METADATA_URL=

# --- stdio transport (local clients) ---
# Identity and scopes granted to the local process. Empty scopes = every tool denied.
MCP_STDIO_ACTOR_ID=
MCP_STDIO_SCOPES=
